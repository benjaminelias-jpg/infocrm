# Postgres del CRM (puede ser la misma base de Kunfupay en otro esquema, o una propia)
DATABASE_URL=postgres://usuario:clave@host:5432/infocrm
JWT_SECRET=cambiame-por-algo-largo-y-secreto
# Sin login: entra directo como el dueño de la cuenta (pedido: va embebido en Kunfupay)
SIN_LOGIN=1
# URL pública donde queda montado (para los avisos de Instagram y links de recursos)
APP_URL=https://business.kunfupay.com/crm
API_URL=https://business.kunfupay.com/crm
# Instagram (app de Meta)
META_APP_ID=
META_APP_SECRET=
