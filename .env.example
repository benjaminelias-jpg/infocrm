# Copia a .env y rellena. En producción, el host (Railway/Render/Neon) inyecta
# estas variables; no subas .env al repositorio.

# Postgres (en producción, la cadena que te da Neon/Supabase/Railway)
DATABASE_URL=postgres://usuario:password@host:5432/infocrm

# Secreto para firmar los tokens de sesión. GENERA UNO LARGO Y ÚNICO:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=pon-aqui-un-secreto-largo-y-unico

# URL pública del servicio (la que verá ManyChat y el panel)
API_URL=https://tu-crm.ejemplo.com
APP_URL=https://tu-crm.ejemplo.com

# Puerto (muchos hosts lo inyectan solos)
PORT=4000
HOST=0.0.0.0
